{
  "name": "@leo_blitz/cesium-sdk",
  "version": "1.0.10",
  "type": "module",
  "description": "A Cesium-based GIS SDK for urban planning, emergency command, military simulation, and data visualization",
  "main": "./dist/cesium-sdk.cjs",
  "module": "./dist/cesium-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cesium-sdk.es.js",
      "require": "./dist/cesium-sdk.cjs",
      "default": "./dist/cesium-sdk.es.js"
    },
    "./blitz_workers/*.js": "./dist/blitz_workers/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:console",
    "build:console": "npm run typecheck && vite build && npm run minify:dist:console && npm run check:dist:console",
    "build:no-console": "npm run typecheck && vite build && npm run minify:dist && npm run check:dist",
    "build:package": "npm run typecheck && vite build --mode package && npm run check:dist:console",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/hex/hex.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "minify:dist": "node scripts/minify-dist.mjs",
    "minify:dist:console": "node scripts/minify-dist.mjs --keep-console",
    "check:dist": "node scripts/check-dist.mjs",
    "check:dist:console": "node scripts/check-dist.mjs --allow-console"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "cesium": "^1.136.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "cesium": "1.136.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "terser": "^5.48.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitepress": "^1.6.4"
  },
  "license": "MIT"
}
